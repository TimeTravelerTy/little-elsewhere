# Copy this file to .env. Keep your key here, never in browser code or chat.
OPENROUTER_API_KEY=
# Jev selects actions; the resident model writes dialogue and reflections.
# Set DECISION_MODEL=llm to compare LLM-only decisions.
DECISION_MODEL=typesafe/jev-1.13
RESIDENT_MODEL=qwen/qwen3.5-9b
MONTHLY_BUDGET_USD=20
WORLD_SEED=4217
DATABASE_PATH=data/world.sqlite
HOST=127.0.0.1
PORT=3000
# Local-only access does not require a token. Public binds require >=32 characters.
OWNER_TOKEN=
COOKIE_SECURE=false
# Cloud only:
DOMAIN=elsewhere.example.com
# Off-server encrypted backups, for the optional backups Compose profile:
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NEWSPAPER_MODEL=google/gemma-4-26b-a4b-it
