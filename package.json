{
  "name": "little-elsewhere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "soak": "node --import tsx scripts/soak.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "restore-check": "node --import tsx scripts/restore-check.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "test:integration": "node --import tsx scripts/integration-check.ts",
    "ai:check": "node --import tsx scripts/ai-check.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
